# Which "brain" powers the agents:
#   local   -> deterministic heuristics, no keys, works offline (default)
#   openai  -> real LLM via the OpenAI API (needs key + `pip install openai`)
LLM_PROVIDER=local

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# How many "repair" attempts Agent 1 gets before we fall back to safe defaults
PARSER_RETRIES=2

LOG_LEVEL=INFO
